sabi
threshold <- mean(sabi$stepMean, na.rm = TRUE)
sabi <- sabi |>
mutate(
static = stepMean < treshold
)
# first, specify a threshold. For a simple approach, we'll use the "mean" value as a threshold value
# to differentiate between stops and moves
threshold <- mean(sabi$stepMean, na.rm = TRUE)
sabi <- sabi |>
mutate(
static = stepMean < treshold
)
# first, specify a threshold. For a simple approach, we'll use the "mean" value as a threshold value
# to differentiate between stops and moves
threshold <- mean(sabi$stepMean, na.rm = TRUE)
sabi <- sabi |>
mutate(
static = stepMean < threshold
)
ggplot(sabi) +
geom_path(aes(E,N)) +
geom_sf(aes(color = static))
sabi_move <- sabi |>
filter(!static)
# first, specify a threshold. For a simple approach, we'll use the "mean" value as a threshold value
# to differentiate between stops and moves
threshold <- mean(sabi$stepMean, na.rm = TRUE)
sabi <- sabi |>
mutate(
static = stepMean < threshold
)
ggplot(sabi) +
geom_path(aes(E,N)) +
geom_sf(aes(color = static))
sabi_move <- sabi |>
filter(!static)
ggplot(sabi_move) +
geom_path(aes(E,N)) +
geom_sf(aes(color = static))
