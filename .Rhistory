library(readr)
wildschwein <- read_delim("Data/wildschwein_BE_2056.csv")
# wildschwein <- read.csv("Data/wildschwein_BE_2056.csv")
wildschwein <- read_csv("Data/wildschwein_BE_2056.csv")
library(sf)
wildschein_sf <- st_as_sf(wildschwein, coords = c("E", "N"), crs = 2056, remove = FALSE)
library(dplyr)
# only get the data form sabi between 1 and 3 of July 2015
sabi <- filter(wildschein_sf, TierName == "Sabi", DatetimeUTC > "2015-07-01", DatetimeUTC < "2015-07-03")
# visualize the result
library(ggplot2)
ggplot(sabi) +
geom_sf() +
geom_path(aes(E, N))
distance_by_element <- function(later, now) {
as.numeric(
st_distance(later, now, by_element = TRUE)
)
}
sabi |>
mutate(
nMinus2 = distance_by_element(lag(geometry, n = 2), geometry)
)
View(sabi)
distance_by_element <- function(later, now) {
as.numeric(
st_distance(later, now, by_element = TRUE)
)
}
sabi |>
mutate(
nMinus2 = distance_by_element(lag(geometry, n = 2), geometry),
nMinus1 = distance_by_element(lag(geometry, n = 1), geometry),
nPlus1 = distance_by_element(geometry, lead(geometry, n = 1)),
nPlus2 = distance_by_element(geometry, lead(geometry, n = 2))
)
sabi <- sabi |>
rowwise()|>
mutate(
stepMean = mean(c(nMinus2, nMinus1, nPlus1, nPlus2), na.rm = FALSE)
)
